# Copy to backend/.env  (never commit the real .env)
NODE_ENV=development
PORT=4000
# Must match docker-compose.yml (user autohub / db autohub)
DATABASE_URL=postgresql://autohub:autohub_dev_password@localhost:5432/autohub
# Isolated database used ONLY by the test suite. The name MUST end with "_test" or the tests refuse to run.
TEST_DATABASE_URL=postgresql://autohub:autohub_dev_password@localhost:5432/autohub_test
# At least 32 characters. Generate a real one for any non-local use:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-change-me-use-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h
# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173
# bcrypt cost factor (tests override this to stay fast)
BCRYPT_ROUNDS=10
# Max requests per 15 minutes per IP on /api/auth/*
AUTH_RATE_LIMIT_MAX=50
# Used ONLY by `npm run db:seed` to create the admin. Development-only defaults - change them.
ADMIN_EMAIL=admin@autohub.local
ADMIN_PASSWORD=ChangeMe123!
