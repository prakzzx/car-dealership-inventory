# ---- Master reference of every variable used by the project (copy the relevant ones to backend/.env and frontend/.env) ----
# Docker Compose (root .env is optional; defaults match these values)
POSTGRES_USER=autohub
POSTGRES_PASSWORD=autohub_dev_password
POSTGRES_DB=autohub

# Backend
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://autohub:autohub_dev_password@localhost:5432/autohub
TEST_DATABASE_URL=postgresql://autohub:autohub_dev_password@localhost:5432/autohub_test
JWT_SECRET=dev-only-change-me-use-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h
CLIENT_URL=http://localhost:5173
ADMIN_EMAIL=admin@autohub.local
ADMIN_PASSWORD=ChangeMe123!

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api
